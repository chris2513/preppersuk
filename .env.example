PUBLIC_SITE_URL=https://your-domain.co.uk
PUBLIC_PRODUCT_PRICE_GBP=7.00
PUBLIC_COMPARE_AT_PRICE_GBP=17.00 # optional strikethrough price; leave blank to hide

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_1UWbUQECNn81vvY2zK80DHhQ # Optional. If set, its Product must have tax_code txcd_10103100 (Managed Payments). If blank, an inline price with that tax code is used.

# Download Signing Secret
DOWNLOAD_HMAC_SECRET=replace_with_32_char_random_secret

# Email Autoresponder (mailerlite | convertkit | resend | loops | brevo). Leave API key empty = mock mode.
EMAIL_PROVIDER=mailerlite
EMAIL_API_KEY=
EMAIL_LIST_ID_LEADS=
EMAIL_LIST_ID_BUYERS=
EMAIL_FROM_ADDRESS=support@your-domain.co.uk

# Support address shown on the site
PUBLIC_SUPPORT_EMAIL=support@your-domain.co.uk

# Optional Ad Pixels
PUBLIC_META_PIXEL_ID=
PUBLIC_GA_MEASUREMENT_ID=
PUBLIC_TIKTOK_PIXEL_ID=
